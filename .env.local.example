# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to GitHub.

# From your Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk sign-in/up routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# From your Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Room dashboard (/dashboard) — Apple Calendar
# In the Calendar app, share a calendar as a "Public Calendar" and paste its
# webcal:// link here. Several calendars: separate with commas. Optional
# label: Name=link, e.g. Work=webcal://...,Home=webcal://...
ICLOUD_CALENDAR_URLS=
# Optional, defaults to America/Denver
DASHBOARD_TIMEZONE=
